diff --git a/css/web-ui.css b/css/web-ui.css
new file mode 100644
index 0000000..3f3645e
--- /dev/null
+++ b/css/web-ui.css
@@ -0,0 +1,3977 @@
+/*
+ * Nuvio Web — Nuvio Web UI
+ * Rebuilt presentation layer based on the approved Stitch Direction A screens.
+ * This file styles the new live screen structures; it is not a cosmetic theme shim.
+ */
+
+:root {
+  --obs-canvas: #090b10;
+  --obs-canvas-2: #0c0e13;
+  --obs-surface-0: #0c0e13;
+  --obs-surface-1: #111318;
+  --obs-surface-2: #1a1b21;
+  --obs-surface-3: #1e1f25;
+  --obs-surface-4: #282a2f;
+  --obs-surface-5: #33353a;
+  --obs-line: rgba(194, 198, 214, 0.16);
+  --obs-line-strong: rgba(194, 198, 214, 0.28);
+  --obs-text: #e2e2e9;
+  --obs-text-soft: #c2c6d6;
+  --obs-text-dim: #8c909f;
+  --obs-primary: #adc6ff;
+  --obs-primary-strong: #4d8eff;
+  --obs-primary-deep: #0267b8;
+  --obs-focus: #8bb7ff;
+  --obs-danger: #ffb4ab;
+  --obs-success: #76d5a3;
+  --obs-shadow: 0 18px 60px rgba(0, 0, 0, 0.36);
+  --obs-shadow-soft: 0 12px 36px rgba(0, 0, 0, 0.26);
+  --obs-glow: 0 0 0 1px rgba(77, 142, 255, 0.7), 0 10px 34px rgba(77, 142, 255, 0.22);
+  --obs-radius-xs: 6px;
+  --obs-radius-sm: 10px;
+  --obs-radius-md: 14px;
+  --obs-radius-lg: 18px;
+  --obs-radius-xl: 24px;
+  --obs-header-h: 64px;
+  --obs-page-x: clamp(18px, 3.5vw, 56px);
+  --obs-page-max: 1600px;
+  --obs-ease: cubic-bezier(0.2, 0.75, 0.25, 1);
+}
+
+html,
+body {
+  background: var(--obs-canvas);
+  color: var(--obs-text);
+  font-family: var(--nuvio-font-body, "Manrope", system-ui, sans-serif);
+}
+
+body.web-with-header {
+  background:
+    radial-gradient(circle at 76% -18%, rgba(77, 142, 255, 0.11), transparent 34rem),
+    var(--obs-canvas);
+}
+
+body.web-with-header #app {
+  padding-top: var(--obs-header-h);
+}
+
+body.web-with-header .screen {
+  background: transparent;
+}
+
+::selection {
+  background: rgba(173, 198, 255, 0.95);
+  color: #001a42;
+}
+
+/* ---------- shared focus ---------- */
+.focusable {
+  outline: none;
+}
+
+.focusable.focused,
+.focusable:focus-visible {
+  outline: none !important;
+}
+
+/* ---------- global top navigation ---------- */
+.obs-topbar {
+  position: fixed;
+  inset: 0 0 auto 0;
+  z-index: 1000;
+  height: var(--obs-header-h);
+  border-bottom: 1px solid rgba(66, 71, 84, 0.4);
+  background: rgba(12, 14, 19, 0.84);
+  -webkit-backdrop-filter: blur(22px) saturate(150%);
+  backdrop-filter: blur(22px) saturate(150%);
+}
+
+.obs-topbar[hidden] {
+  display: none !important;
+}
+
+.obs-topbar-inner {
+  width: 100%;
+  height: 100%;
+  max-width: 1760px;
+  margin: 0 auto;
+  padding: 0 var(--obs-page-x);
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 28px;
+}
+
+.obs-topbar-left,
+.obs-topbar-tools,
+.obs-brand,
+.obs-primary-nav,
+.obs-search-trigger {
+  display: flex;
+  align-items: center;
+}
+
+.obs-topbar-left {
+  gap: clamp(22px, 3vw, 42px);
+  min-width: 0;
+}
+
+.obs-brand {
+  appearance: none;
+  border: 0;
+  background: transparent;
+  color: var(--obs-text);
+  gap: 8px;
+  padding: 0;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.obs-brand-word {
+  font-family: var(--nuvio-font-display, "Space Grotesk", sans-serif);
+  font-size: 20px;
+  line-height: 1;
+  font-weight: 700;
+  letter-spacing: -0.035em;
+}
+
+.obs-brand-badge {
+  min-width: 31px;
+  height: 19px;
+  padding: 0 7px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 5px;
+  border: 1px solid rgba(173, 198, 255, 0.38);
+  background: rgba(77, 142, 255, 0.12);
+  color: var(--obs-primary);
+  font-size: 9px;
+  line-height: 1;
+  font-weight: 800;
+  letter-spacing: 0.08em;
+}
+
+.obs-primary-nav {
+  height: 100%;
+  gap: clamp(18px, 2.2vw, 30px);
+}
+
+.obs-nav-link {
+  position: relative;
+  appearance: none;
+  border: 0;
+  background: none;
+  color: var(--obs-text-soft);
+  padding: 0;
+  height: 100%;
+  cursor: pointer;
+  font: 600 14px/1 var(--nuvio-font-body, "Manrope", sans-serif);
+  transition: color 160ms ease;
+}
+
+.obs-nav-link::after {
+  content: "";
+  position: absolute;
+  left: 50%;
+  bottom: 10px;
+  width: 0;
+  height: 2px;
+  transform: translateX(-50%);
+  border-radius: 99px;
+  background: var(--obs-primary);
+  transition: width 180ms var(--obs-ease);
+}
+
+.obs-nav-link:hover,
+.obs-nav-link[aria-current="page"] {
+  color: var(--obs-text);
+}
+
+.obs-nav-link[aria-current="page"]::after {
+  width: 28px;
+}
+
+.obs-topbar-tools {
+  gap: 10px;
+  flex: 0 1 auto;
+  min-width: 0;
+}
+
+.obs-search-trigger {
+  width: clamp(220px, 24vw, 330px);
+  height: 38px;
+  gap: 9px;
+  padding: 0 10px 0 12px;
+  border: 1px solid rgba(66, 71, 84, 0.7);
+  border-radius: 9px;
+  background: rgba(26, 27, 33, 0.75);
+  color: var(--obs-text-soft);
+  cursor: pointer;
+  transition: border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
+}
+
+.obs-search-trigger:hover,
+.obs-search-trigger:focus-visible {
+  border-color: rgba(173, 198, 255, 0.5);
+  background: rgba(30, 31, 37, 0.95);
+  box-shadow: 0 0 0 3px rgba(77, 142, 255, 0.08);
+}
+
+.obs-search-trigger svg,
+.obs-icon-button svg {
+  width: 18px;
+  height: 18px;
+}
+
+.obs-search-trigger-label {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  flex: 1;
+  text-align: left;
+  font-size: 12px;
+}
+
+.obs-search-trigger kbd {
+  padding: 2px 6px;
+  border-radius: 5px;
+  border: 1px solid rgba(140, 144, 159, 0.25);
+  background: rgba(51, 53, 58, 0.65);
+  color: var(--obs-text-dim);
+  font: 600 10px/1.4 var(--nuvio-font-mono, monospace);
+}
+
+.obs-icon-button,
+.obs-avatar-button {
+  width: 38px;
+  height: 38px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid transparent;
+  background: transparent;
+  color: var(--obs-text-soft);
+  border-radius: 50%;
+  cursor: pointer;
+  transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
+}
+
+.obs-icon-button:hover,
+.obs-icon-button:focus-visible,
+.obs-avatar-button:hover,
+.obs-avatar-button:focus-visible {
+  color: var(--obs-text);
+  background: rgba(51, 53, 58, 0.65);
+  border-color: rgba(140, 144, 159, 0.18);
+}
+
+.obs-avatar-button {
+  position: relative;
+  padding: 2px;
+}
+
+.obs-avatar {
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  background: linear-gradient(135deg, #25304a, #11141d);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.obs-avatar-status {
+  position: absolute;
+  right: 2px;
+  bottom: 2px;
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--obs-success);
+  box-shadow: 0 0 0 2px var(--obs-surface-0);
+}
+
+.web-back-navigation {
+  z-index: 900;
+  top: calc(var(--obs-header-h) + 10px);
+  left: var(--obs-page-x);
+}
+
+.web-back-navigation button {
+  border-radius: 999px !important;
+  border: 1px solid var(--obs-line) !important;
+  background: rgba(12, 14, 19, 0.84) !important;
+  backdrop-filter: blur(16px);
+}
+
+/* ---------- shared page primitives ---------- */
+.obs-page {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  overflow: auto;
+  overscroll-behavior: contain;
+  background:
+    radial-gradient(circle at 72% -10%, rgba(77, 142, 255, 0.06), transparent 28rem),
+    var(--obs-canvas);
+  color: var(--obs-text);
+  scrollbar-width: thin;
+  scrollbar-color: rgba(140, 144, 159, 0.4) transparent;
+}
+
+.obs-page-inner {
+  width: min(100%, var(--obs-page-max));
+  margin: 0 auto;
+  padding: 34px var(--obs-page-x) 72px;
+}
+
+.obs-page-head {
+  display: flex;
+  align-items: end;
+  justify-content: space-between;
+  gap: 20px;
+  margin-bottom: 24px;
+}
+
+.obs-page-title {
+  margin: 0;
+  font-family: var(--nuvio-font-display, "Space Grotesk", sans-serif);
+  font-size: clamp(32px, 3.2vw, 46px);
+  line-height: 1.03;
+  letter-spacing: -0.035em;
+  font-weight: 700;
+  color: var(--obs-text);
+}
+
+.obs-page-subtitle {
+  margin: 6px 0 0;
+  color: var(--obs-text-dim);
+  font-size: 13px;
+  line-height: 1.55;
+}
+
+.obs-kicker {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  margin-bottom: 9px;
+  color: var(--obs-primary);
+  font-size: 10px;
+  line-height: 1;
+  font-weight: 800;
+  letter-spacing: 0.11em;
+  text-transform: uppercase;
+}
+
+.obs-kicker::before {
+  content: "";
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--obs-primary);
+  box-shadow: 0 0 14px rgba(173, 198, 255, 0.5);
+}
+
+.obs-panel {
+  border: 1px solid var(--obs-line);
+  border-radius: var(--obs-radius-md);
+  background: rgba(30, 31, 37, 0.72);
+  box-shadow: var(--obs-shadow-soft);
+}
+
+.obs-btn {
+  min-height: 40px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 0 16px;
+  border-radius: 9px;
+  border: 1px solid var(--obs-line);
+  background: rgba(40, 42, 47, 0.85);
+  color: var(--obs-text);
+  font: 700 12px/1 var(--nuvio-font-body, "Manrope", sans-serif);
+  cursor: pointer;
+}
+
+.obs-btn-primary {
+  border-color: rgba(173, 198, 255, 0.8);
+  background: var(--obs-primary);
+  color: #001a42;
+}
+
+.obs-btn-ghost {
+  border-color: transparent;
+  background: transparent;
+  color: var(--obs-text-soft);
+}
+
+.obs-chip {
+  min-height: 32px;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 0 12px;
+  border-radius: 999px;
+  border: 1px solid var(--obs-line);
+  background: rgba(30, 31, 37, 0.7);
+  color: var(--obs-text-soft);
+  font-size: 11px;
+  font-weight: 700;
+}
+
+.obs-chip.is-active,
+.obs-chip.selected,
+.obs-chip.focused {
+  border-color: rgba(173, 198, 255, 0.62);
+  background: rgba(77, 142, 255, 0.15);
+  color: var(--obs-primary);
+}
+
+/* ---------- home ---------- */
+.home-screen-shell {
+  background: var(--obs-canvas) !important;
+}
+
+.home-screen-main,
+.home-route-content,
+.home-modern-stage,
+.home-modern-rows-viewport,
+.home-modern-rows-scroll {
+  width: 100%;
+  height: 100%;
+}
+
+.home-screen-main {
+  overflow: auto !important;
+  padding: 0 !important;
+  scrollbar-width: none;
+}
+
+.home-screen-main::-webkit-scrollbar,
+.home-modern-rows-viewport::-webkit-scrollbar,
+.home-track::-webkit-scrollbar {
+  display: none;
+}
+
+.obs-home-stage {
+  min-height: 100%;
+  background: var(--obs-canvas);
+}
+
+.home-hero-modern.obs-hero {
+  position: relative;
+  height: clamp(540px, 69vh, 760px);
+  min-height: 520px;
+  margin: 0;
+  overflow: hidden;
+  isolation: isolate;
+}
+
+.obs-hero .home-hero-visual,
+.obs-hero .home-modern-hero-media,
+.obs-hero .home-hero-backdrop-wrap {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.obs-hero .home-hero-backdrop,
+.obs-hero .home-hero-backdrop-wrap img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: center 35%;
+  filter: saturate(0.93) contrast(1.02) brightness(0.73);
+}
+
+.obs-hero::before,
+.obs-hero::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  pointer-events: none;
+}
+
+.obs-hero::before {
+  background:
+    linear-gradient(90deg, rgba(9, 11, 16, 0.97) 0%, rgba(9, 11, 16, 0.72) 34%, rgba(9, 11, 16, 0.12) 68%, rgba(9, 11, 16, 0.08) 100%),
+    linear-gradient(0deg, var(--obs-canvas) 0%, rgba(9, 11, 16, 0.88) 8%, rgba(9, 11, 16, 0.18) 37%, rgba(9, 11, 16, 0.1) 100%);
+}
+
+.obs-hero::after {
+  background: radial-gradient(circle at 78% 15%, rgba(77, 142, 255, 0.08), transparent 34rem);
+}
+
+.obs-hero .home-modern-hero-card {
+  position: relative;
+  z-index: 2;
+  height: 100%;
+  display: flex;
+  align-items: flex-end;
+  padding: 0 var(--obs-page-x) clamp(76px, 9vh, 108px);
+  max-width: 1760px;
+  margin: 0 auto;
+  background: none;
+  border: 0;
+}
+
+.obs-hero .home-hero-content-grid {
+  width: min(660px, 70vw);
+}
+
+.obs-hero .home-hero-copy {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 12px;
+}
+
+.obs-hero-eyebrow {
+  margin-bottom: 2px;
+}
+
+.obs-hero .home-hero-eyebrow-pill {
+  padding: 0;
+  border: 0;
+  background: none;
+  color: var(--obs-primary);
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.obs-hero .home-hero-eyebrow-pill::before {
+  content: "";
+  display: inline-block;
+  width: 6px;
+  height: 6px;
+  margin-right: 8px;
+  vertical-align: 1px;
+  border-radius: 50%;
+  background: var(--obs-primary);
+}
+
+.obs-hero .home-hero-logo {
+  width: auto;
+  max-width: min(520px, 60vw);
+  max-height: 112px;
+  object-fit: contain;
+  object-position: left center;
+}
+
+.obs-hero .home-hero-title-text {
+  margin: 0;
+  font-family: var(--nuvio-font-display, "Space Grotesk", sans-serif);
+  font-size: clamp(40px, 5.2vw, 74px);
+  line-height: 0.98;
+  letter-spacing: -0.055em;
+  font-weight: 700;
+  color: #f7f8fb;
+  text-wrap: balance;
+}
+
+.obs-hero .home-modern-hero-meta-line,
+.obs-hero .home-modern-hero-secondary {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 7px;
+  color: #d2d5de;
+  font-size: 12px;
+  line-height: 1.4;
