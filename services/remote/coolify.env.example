# Runtime environment for the remote.gykstudio.tech service, not NuvioWeb.
HOST=0.0.0.0
PORT=3001
# Mount a persistent Coolify volume at /data. Run only one replica.
REMOTE_DATA_FILE=/data/remote.json
REMOTE_AUDIT_DAYS=7
REMOTE_ALLOWED_ORIGINS=https://movies.gykstudio.tech
REMOTE_DEVICE_ORIGINS=https://remote.gykstudio.tech
NUVIO_SUPABASE_URL=https://nuvio.gykstudio.tech
NUVIO_SUPABASE_ANON_KEY=REPLACE_WITH_BACKEND_PUBLIC_KEY
